# Marketing Task Management Dashboard — environment variables
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real credentials.
# For the Vercel deployment, add the same three variables under
# Project Settings -> Environment Variables, then redeploy.
#
# Full setup walkthrough: see "Connecting to Google Sheets" in README.md


# ---------------------------------------------------------------------------
# Required — Google Sheets connection
# ---------------------------------------------------------------------------

# The spreadsheet id, taken from the sheet URL. For
#   https://docs.google.com/spreadsheets/d/1wgOv_kftukxOeNjMTnaO81d_8BoHOJgpUy7CfsTzi84/edit
# the id is the segment between /d/ and /edit. Use the id only, not the URL.
GOOGLE_SHEETS_SPREADSHEET_ID=1wgOv_kftukxOeNjMTnaO81d_8BoHOJgpUy7CfsTzi84

# The service account's email, from the downloaded JSON key ("client_email").
# Looks like: marketing-dashboard@your-project.iam.gserviceaccount.com
# The spreadsheet must be shared with this address as an Editor.
#
# Leave this and GOOGLE_PRIVATE_KEY both blank when deploying to Cloud Run, GCE
# or GKE with a service account attached to the service/instance — the app
# then authenticates via the GCP metadata server instead, with no key at all.
# This is the only option on a project whose org policy blocks service-account
# key creation. See "Keyless auth on Google Cloud" in README.md.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key, from the JSON key ("private_key").
#
# Keep the surrounding double quotes and the literal \n sequences exactly as
# they appear in the JSON file. Include the BEGIN and END lines.
#
# Example shape (not a real key):
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n...\n-----END PRIVATE KEY-----\n"
#
# Leave blank on Cloud Run / GCE / GKE — see the note above.
GOOGLE_PRIVATE_KEY=""


# ---------------------------------------------------------------------------
# Required — Sign-in (email + password)
# ---------------------------------------------------------------------------
#
# There is no per-user password store: the app accepts exactly one email and
# password pair, defined here. Whoever signs in with it is then subject to the
# normal Users-tab allowlist (see INITIAL_ADMIN_EMAILS below to bootstrap the
# first Admin). This is a SEPARATE credential from the service account above:
# the service account reads the spreadsheet, while this identifies the person
# signing in.
#
# Defaults to admin@marketingdashboard.com / password123 if left blank —
# set your own before this leaves a throwaway/demo environment.
DEMO_USER_EMAIL=admin@marketingdashboard.com
DEMO_USER_PASSWORD=password123

# Key used to sign session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Changing this value signs everyone out.
SESSION_SECRET=

# The public origin of this deployment, with no trailing slash.
# The OAuth redirect URI is built from this, so it must match what you
# registered above. It is read from configuration rather than the request Host
# header, so a spoofed host cannot redirect the sign-in flow elsewhere.
#   local:    http://localhost:3000
#   deployed: https://your-domain.com
APP_URL=http://localhost:3000

# Bootstrap: who may claim the first Admin account.
# Comma-separated. Only applies while the `Users` tab has no users at all —
# once anyone exists this list stops granting access, so a stale value here
# cannot become a permanent back door.
# Left blank, this defaults to DEMO_USER_EMAIL, since that is the only account
# that can sign in at all — otherwise nobody could ever get in.
INITIAL_ADMIN_EMAILS=


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Restrict sign-in to a single email domain, e.g. company.com
# Applied on top of the Users allowlist, as defence in depth. Leave blank to
# allow any domain (access is still limited to listed users).
ALLOWED_EMAIL_DOMAIN=

# IANA timezone used for all business dates: deadlines, execution dates,
# completion dates and the overdue calculation. Defaults to Asia/Kolkata.
# Set both variables to the same value so the server and browser agree.
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
