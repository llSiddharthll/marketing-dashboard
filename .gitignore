# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# service-account keys — this project deliberately avoids ever needing one
# (see README's "Keyless auth on Google Cloud"), so one showing up here is
# almost always a mistake, not something to commit
*-key.json
sa-key*.json
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and must be committed so new
# developers know which variables to set.
!.env.example

# working files with real secrets pasted in for pasting into a host's
# dashboard — never belongs in history, public repo or not
VERCEL_ENV_VARIABLES.txt

# client voice notes / drop folder — working input, not project source
clients/

# packaged deliverable, not source — rebuild instead of committing a blob
marketing-dashboard-client-pkg.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
